{
  "name": "shroom-labs-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/write-config.js && node scripts/generate-seo.js",
    "dev": "API_BASE_URL=${API_BASE_URL:-http://127.0.0.1:8787} node scripts/write-config.js && python3 -m http.server 8888 --directory public",
    "deploy": "API_BASE_URL=${API_BASE_URL:-https://api.shroomlabs.io} node scripts/write-config.js && npx --yes netlify-cli deploy --prod --dir=public"
  }
}
