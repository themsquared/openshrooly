# === Frontend (Netlify) ===
# Public origin of the Cloudflare Worker (no trailing slash).
API_BASE_URL=https://openshrooly-community-api.yourname.workers.dev

# === API (Cloudflare Worker) ===
# Allowed browser origin. Must match the Netlify site URL in production.
CORS_ORIGIN=https://your-site.netlify.app
SHOW_PSILOCYBIN=1
SITE_NAME=OpenShrooly Community

# wrangler secret put COMMUNITY_SECRET
COMMUNITY_SECRET=change-me

# Optional webhook signing secret for a future live Stripe provider (unused stub).
# wrangler secret put STRIPE_WEBHOOK_SECRET
STRIPE_WEBHOOK_SECRET=

# === Local hub talking to this API ===
COMMUNITY_URL=https://openshrooly-community-api.yourname.workers.dev
COMMUNITY_TOKEN=mint-from-account-page
HUB_ENABLE_PSILOCYBIN=0
