# === Shroom Labs (shroomlabs.io) ===
# Frontend: Netlify at https://shroomlabs.io
# API: Cloudflare Worker at https://api.shroomlabs.io
# Photos: R2 public domain at https://cdn.shroomlabs.io

# Netlify build — public API origin (no trailing slash).
API_BASE_URL=https://api.shroomlabs.io
# Optional; defaults to https://cdn.shroomlabs.io
MEDIA_BASE_URL=https://cdn.shroomlabs.io

# Worker vars (wrangler.toml [vars] or dashboard)
CORS_ORIGIN=https://shroomlabs.io,https://www.shroomlabs.io
CDN_BASE_URL=https://cdn.shroomlabs.io
SHOW_PSILOCYBIN=1
SITE_NAME=Shroom Labs

SITE_ORIGIN=https://shroomlabs.io
WEBAUTHN_RP_ID=shroomlabs.io
# Local only. Completing stubs (fake email, OIDC, checkout, canned coach)
# require DEV_STUBS=1 and refuse shroomlabs.io / api.shroomlabs.io hosts.
# Never set DEV_STUBS on the production Worker.
AUTH_DEBUG=0
DEV_STUBS=0
OIDC_STUB=0
HIBP_DISABLED=0

# wrangler secret put COMMUNITY_SECRET
COMMUNITY_SECRET=change-me
# GOOGLE_CLIENT_ID is a public [vars] entry in api/wrangler.toml
# wrangler secret put GOOGLE_CLIENT_SECRET
# wrangler secret put APPLE_CLIENT_ID
# wrangler secret put APPLE_CLIENT_SECRET
# wrangler secret put RESEND_API_KEY
# wrangler secret put TURNSTILE_SECRET_KEY
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=
EMAIL_FROM=Shroom Labs <noreply@shroomlabs.io>

# Signed payment webhooks. Required in production. Local tests use a fixture secret.
# wrangler secret put PAYMENTS_WEBHOOK_SECRET
PAYMENTS_WEBHOOK_SECRET=
# 32-byte hex key for AES-GCM TOTP secrets.
# wrangler secret put TOTP_ENC_KEY
TOTP_ENC_KEY=
# Local magic-link tests only. Production must set TURNSTILE_SECRET_KEY and leave this unset.
TURNSTILE_STUB=

# Grow Coach (culinary subscription). Local Node stubs the model.
# Prod wrangler.deploy.toml does not bind [ai] and must not set ENVIRONMENT=local
# or WORKERS_AI_TOKEN. Local beta REST: community/api/COACH-LOCAL.md (.dev.vars).
GROW_COACH_STUB=1
GROW_COACH_PROVIDER=stub
GROW_COACH_TEXT_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
GROW_COACH_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct

# === Local hub talking to Shroom Labs ===
COMMUNITY_URL=https://api.shroomlabs.io
COMMUNITY_TOKEN=mint-from-account-page
HUB_ENABLE_PSILOCYBIN=0
